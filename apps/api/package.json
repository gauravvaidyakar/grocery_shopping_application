{
  "name": "@vishwaneed/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "nest start --watch",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/start-local-api.ps1",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "vitest run --exclude test/mongodb.integration.spec.ts",
    "test:watch": "vitest",
    "mongodb:setup": "tsx scripts/setup-mongodb.ts",
    "mongodb:seed": "tsx scripts/seed-mongodb.ts",
    "test:mongodb": "vitest run test/mongodb.integration.spec.ts",
    "test:api-mongodb": "npm run build && tsx scripts/smoke-mongodb-api.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.0.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "12.0.3",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "12.0.3",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/throttler": "^6.7.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.4.1",
    "helmet": "^8.1.0",
    "mongoose": "^9.10.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "12.0.3",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "5.0.1"
  }
}
