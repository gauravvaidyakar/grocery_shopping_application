NODE_ENV=development
PORT=4000
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster-host>/grocery_web_application?retryWrites=true&w=majority
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
BANK_DATA_ENCRYPTION_KEY=replace-with-64-hex-characters-for-aes-256-key
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
PRIVATE_UPLOAD_DIR=./private-uploads
PUBLIC_UPLOAD_DIR=./public-uploads
MAX_UPLOAD_BYTES=5242880
SETTLEMENT_DAYS=7
RETURN_WINDOW_DAYS=7
CHECKOUT_QUOTE_TTL_MINUTES=10
PASSWORD_RESET_TTL_MINUTES=30
CUSTOMER_WEB_URL=http://localhost:5173
SHIPPING_PROVIDER=DEVELOPMENT
DEV_SHIPPING_BASE_MINOR=4000
DEV_SHIPPING_PER_KG_MINOR=2000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_SECRET=
INTERAKT_API_KEY=
INTERAKT_API_URL=https://api.interakt.ai/v1/public/message/
WHATSAPP_PROVIDER=DEVELOPMENT
# Customer authentication OTPs use SMS, not WhatsApp. No SMS vendor is bundled
# until an approved provider account and credentials are supplied.
SMS_PROVIDER=MSG91
MSG91_AUTH_KEY=
# Customer authentication uses the default MSG91 OTP Widget configuration.
MSG91_WIDGET_ID=
MSG91_WIDGET_TOKEN=
# Optional legacy server-generated OTP template (not used by customer auth).
MSG91_OTP_TEMPLATE_ID=
MSG91_API_URL=https://control.msg91.com/api/v5/otp
MSG91_DEFAULT_COUNTRY_CODE=91
# Use INTERAKT above for non-authentication WhatsApp notifications.
WHATSAPP_TEMPLATE_ORDER_CONFIRMATION=order_confirmation
WHATSAPP_TEMPLATE_VENDOR_NEW_ORDER=vendor_new_order
WHATSAPP_TEMPLATE_PAYMENT_CONFIRMATION=payment_confirmation
WHATSAPP_TEMPLATE_PAYMENT_FAILED=payment_failed
WHATSAPP_TEMPLATE_ORDER_ITEM_CANCELLED=order_item_cancelled
WHATSAPP_TEMPLATE_VENDOR_ITEM_CANCELLED=vendor_item_cancelled
WHATSAPP_TEMPLATE_VENDOR_ORDER_STATUS_UPDATE=vendor_order_status_update
WHATSAPP_TEMPLATE_VENDOR_PAYMENT_STATUS=vendor_payment_status
WHATSAPP_TEMPLATE_VENDOR_SHIPMENT_STATUS=vendor_shipment_status
WHATSAPP_TEMPLATE_RETURN_STATUS_UPDATE=return_status_update
WHATSAPP_TEMPLATE_VENDOR_RETURN_REQUESTED=vendor_return_requested
WHATSAPP_TEMPLATE_VENDOR_RETURN_STATUS=vendor_return_status
WHATSAPP_TEMPLATE_ORDER_CONFIRMED=order_confirmed
WHATSAPP_TEMPLATE_ORDER_PROCESSING=order_processing
WHATSAPP_TEMPLATE_ORDER_PACKED=order_packed
WHATSAPP_TEMPLATE_ORDER_SHIPPED=order_shipped
WHATSAPP_TEMPLATE_ORDER_DELIVERED=order_delivered
WHATSAPP_TEMPLATE_SHIPMENT_PENDING=shipment_pending
WHATSAPP_TEMPLATE_SHIPMENT_READY_TO_SHIP=shipment_ready_to_ship
WHATSAPP_TEMPLATE_SHIPMENT_PICKED_UP=shipment_picked_up
WHATSAPP_TEMPLATE_SHIPMENT_IN_TRANSIT=shipment_in_transit
WHATSAPP_TEMPLATE_SHIPMENT_OUT_FOR_DELIVERY=shipment_out_for_delivery
WHATSAPP_TEMPLATE_SHIPMENT_DELIVERED=shipment_delivered
WHATSAPP_TEMPLATE_SHIPMENT_FAILED=shipment_failed
WHATSAPP_TEMPLATE_SHIPMENT_CANCELLED=shipment_cancelled
WHATSAPP_TEMPLATE_SHIPMENT_RETURNED=shipment_returned
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
