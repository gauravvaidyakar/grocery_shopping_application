{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npm run build --workspace @vishwaneed/vendor-panel",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "/vendor", "permanent": false }
  ],
  "rewrites": [
    { "source": "/vendor/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/vendor", "destination": "/index.html" },
    { "source": "/vendor/:path*", "destination": "/index.html" }
  ]
}
